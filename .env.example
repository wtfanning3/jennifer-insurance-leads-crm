# Copy to .env.local for local testing. In production, set these in Vercel:
# Project > Settings > Environment Variables. See docs/SETUP.md.

# --- Supabase (database + sign-in) - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only - never share this one
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- The CRM's public address (used in the links inside texts and emails)
NEXT_PUBLIC_APP_URL=https://your-crm.vercel.app
# Optional: a short custom domain just for links in texts (e.g. https://jrf.link)
PUBLIC_LINK_BASE_URL=

# --- SmartFinancial lead delivery - any long random string (openssl rand -hex 24)
SMARTFINANCIAL_WEBHOOK_SECRET=

# --- Scheduled job (follow-up texts, morning welcome texts) - any long random string
CRON_SECRET=

# --- Texting: fill in Twilio OR Telnyx
# Twilio (twilio.com) - Console > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19705551234
# (or, instead of a FROM number, a Messaging Service)
TWILIO_MESSAGING_SERVICE_SID=
# Telnyx (telnyx.com)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
# twilio or telnyx - only needed if both are filled in
SMS_PROVIDER=

# --- Email (resend.com) - new-lead emails, reply alerts, follow-up reminders
RESEND_API_KEY=
# Must be on a domain you verified in Resend
EMAIL_FROM=Leads CRM <leads@yourdomain.com>
# Fallback list if Settings > Lead emails is empty
NOTIFY_EMAILS=

# --- AI (console.anthropic.com) - texting assistant + "AI help" writing
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 costs far less per reply; default is claude-opus-5-5
AI_MODEL=
